      { "at": "pc.link.RobotLink", "path": "pc/robot/src/link.ts", "code": "case \"tof\": this.emit(\"frame\", withoutType(m)); break;" },
      { "at": "pc.ingest.ingest", "path": "pc/robot/src/ingest.ts", "code": "robot.on(\"frame\", (f: MoveFrame)" },
      { "change": "turn", "name": "seconds", "at": "pc.boot.Boot.frame",
        "what": "numbered as the boot's next message; time in seconds", "dto": "pc.boot.FrameRow",
        "path": "pc/robot/src/boot.ts", "code": "frame(f: MoveFrame, atMs = Date.now()): FrameRow {" },
      { "at": "pc.store.Store.frame" }
    ]
  },
  {
    "id": "tof-map",
    "name": "ToF frame to the robot's map",
    "description": "Each posed frame, packed and unpacked as the PC gets it, into the robot's 6 × 6 m map.",
