        "bytes": 289,
        "path": "picoA/app/wire.c", "code": "uint32_t wire_encode_tof(tof_use_t use, uint32_t move, uint64_t t_us, const posed_frame_t *f, uint8_t *out) {" },
      { "at": "picoA.link_pc.link_send_bulk", "path": "picoA/app/move.c", "code": "if (link_send_bulk(msg, n)) cur.sent++;" },
      { "at": "pc.wire.WireReader.push", "path": "pc/robot/src/link.ts", "code": "for (const raw of reader.push(chunk))" },
      { "change": "turn", "name": "decode", "at": "pc.wire.decode",
        "what": "the move's number and time read; the rest handed to unpackTof",
        "path": "pc/robot/src/wire.ts", "code": "return { type: \"tof\", format: f.name," },
      { "change": "turn", "name": "unpack", "at": "pc.tof_format.unpackTof",
