      { "change": "add", "name": "pose", "at": "picoA.pose.pose_stamp",
        "what": "the pose at the frame's middle, the turn during it, still or not (flow odometry)",
        "dto": "picoA.tof_frame.posed_frame_t",
        "path": "picoA/app/pose.c", "code": "void pose_stamp(const tof_frame_t *frame, posed_frame_t *out) {" },
      { "at": "picoA.move.move_tof", "path": "picoA/app/main.c", "code": "move_tof(&posed);" },
      { "change": "turn", "name": "64-bit time", "at": "picoA.move.move_tof",
