[
  {
    "id": "odometry",
    "name": "Odometry",
    "description": "PicoB turns the IMU and the wheel counts into the pose, speeds and tilt, and reports them to PicoA 50 times a second; PicoA keeps them as a history to place each ToF frame.",
    "steps": [
      { "at": "picoB.imu.imu_read", "dto": "picoB.imu.imu_sample_t",
        "rate": { "text": "416 Hz", "path": "picoB/drivers/imu.c", "code": "write_reg(CTRL2_G, 0x60)" },
        "path": "picoB/app/odometry.c", "code": "!imu_read(&s, &counts)" },
      { "change": "turn", "name": "robot frame", "at": "picoB.odometry.odom_update",
        "what": "the sensor's axes into the robot's (the mounting)",
        "path": "picoB/app/odometry.c", "code": "to_robot_frame(&s, accel_g, gyro_dps);" },
      { "change": "turn", "name": "heading", "at": "picoB.odometry.odom_update",
        "what": "gyro z, less its bias, into the heading",
        "path": "picoB/app/odometry.c", "code": "update_heading(gyro_dps[2], dt);" },
      { "change": "add", "name": "wheels", "at": "picoB.odometry.odom_update",
        "what": "the wheel counts (flow wheel-counts) into distance, speed and position",
        "path": "picoB/app/odometry.c", "code": "update_wheels(dt);" },
      { "change": "turn", "name": "tilt", "at": "picoB.odometry.odom_update",
        "what": "accel and gyro into pitch and roll (filter, 0.5 s)", "dto": "picoB.odometry.odom_t",
        "path": "picoB/app/odometry.c", "code": "update_tilt(accel_g, gyro_dps, dt);" },
      { "at": "picoB.odometry.odom_get" },
      { "change": "turn", "name": "report", "at": "picoB.brain.brain_update",
        "what": "the fields PicoA needs, plus the motors' state and why they stopped",
        "dto": "common.link_msgs.odom_report_t",
        "rate": { "text": "50 Hz", "path": "picoB/app/brain.c", "code": "next_odom = make_timeout_time_us(LINK_ODOM_PERIOD_US);" },
        "path": "picoB/app/brain.c", "code": "odom_report_t r = {" },
      { "at": "common.link.link_send", "path": "picoB/app/brain.c", "code": "link_send(MSG_ODOM, &r, sizeof r);" },
      { "at": "common.link.link_receive", "path": "picoA/app/body.c", "code": "while (link_receive(&m)) on_message(&m);" },
      { "change": "turn", "name": "PicoA's clock", "at": "picoA.body.body_update",
        "what": "learns PicoB's clock from each report's time, so its times can be read on PicoA's",
        "path": "picoA/app/body.c", "code": "track_clock(time_us_32() - odom.t_us, time_us_32());" },
      { "at": "picoA.body.body_odom_get", "path": "picoA/app/pose.c", "code": "if (!body_odom_get(++taken, &o, &t_us)) continue;" },
      { "change": "pick", "name": "history", "at": "picoA.pose.pose_update",
        "what": "each report into the pose history (~1.3 s): roll, wheel distances and the motors' state dropped",
        "keeps": ["x_m", "y_m", "yaw_rad", "pitch_rad", "v_mps", "w_radps", "stationary"], "bytes": 32,
        "path": "picoA/app/pose.c", "code": ".pose = {o.x_m, o.y_m, o.yaw_rad, o.pitch_rad}," },
      { "change": "turn", "name": "interpolate", "at": "picoA.pose.pose_stamp",
        "what": "the history into the pose at the frame's middle (the private at(), not pose_at())", "dto": "picoA.pose.pose_t",
        "path": "picoA/app/pose.c", "code": "out->pose_known = at(frame->t_us, &mid, &still);" }
    ]
  },
  {
    "id": "wheel-counts",
    "name": "Wheel counts",
    "description": "The four encoder counts, read by odometry each IMU sample and joined into the pose.",
    "steps": [
      { "at": "picoB.encoder.encoder_count", "bytes": 16,
        "path": "picoB/app/odometry.c", "code": "int32_t count = encoder_count(i);" },
      { "at": "picoB.odometry.odom_update" }
    ]
  },
  {
    "id": "tilt-stop",
    "name": "Tilt stop",
    "description": "PicoB switches the motors off when pitch or roll passes 15°; only the two angles are read out of odometry.",
    "parent": "odometry",
    "steps": [
      { "at": "picoB.odometry.odom_get",
        "rate": { "text": "100 Hz", "path": "picoB/app/main.c", "code": "#define CONTROL_PERIOD_US" },
        "path": "picoB/app/main.c", "code": "drive_update(odom_get());" },
      { "change": "pick", "name": "pitch, roll", "at": "picoB.drive.drive_update",
        "keeps": ["pitch_rad", "roll_rad"], "bytes": 8,
        "path": "picoB/app/drive.c", "code": "fabsf(odom->pitch_rad) > MAX_TILT_RAD" }
    ]
  },
  {
    "id": "imu-to-pc",
    "name": "IMU to the PC",
    "description": "The IMU's raw counts, averaged 4 to 1 on PicoB, carried through PicoA in batches of 10 during a move and stored on the PC as training data.",
    "steps": [
      { "at": "picoB.imu.imu_read", "dto": "picoB.imu.imu_counts_t",
        "rate": { "text": "416 Hz", "path": "picoB/drivers/imu.c", "code": "write_reg(CTRL2_G, 0x60)" },
        "path": "picoB/app/odometry.c", "code": "!imu_read(&s, &counts)" },
      { "change": "turn", "name": "average 4", "at": "picoB.odometry.odom_update",
        "what": "4 samples in a row averaged into one record, stamped with their middle time",
        "dto": "common.link_msgs.imu_record_t",
        "rate": { "text": "104 Hz", "path": "common/link_msgs.h", "code": "#define IMU_RECORD_SAMPLES" },
        "path": "picoB/app/odometry.c", "code": "static void update_record(" },
      { "at": "picoB.odometry.odom_imu_take", "path": "picoB/app/brain.c", "code": "while (odom_imu_take(&r))" },
      { "at": "common.link.link_send", "path": "picoB/app/brain.c", "code": "link_send(MSG_IMU, &r, sizeof r);" },
      { "at": "common.link.link_receive", "path": "picoA/app/body.c", "code": "while (link_receive(&m)) on_message(&m);" },
      { "change": "turn", "name": "PicoA's clock", "at": "picoA.body.body_update",
        "what": "the record's time from PicoB's clock to PicoA's",
        "path": "picoA/app/body.c", "code": "r->t_us = on_picoa_clock(r->t_us);" },
      { "at": "picoA.body.body_imu_take", "path": "picoA/app/main.c", "code": "while (body_imu_take(&r)) move_imu(&r);" },
      { "at": "picoA.move.move_imu" },
      { "change": "turn", "name": "batch", "at": "picoA.move.move_imu",
        "what": "up to 10 records in a row into a batch with the move's number; a gap starts a new batch",
        "dto": "picoA.wire.wire_imu_batch_t",
        "rate": { "text": "~10 Hz", "path": "picoA/app/wire.h", "code": "#define WIRE_IMU_BATCH_MAX" },
        "path": "picoA/app/move.c", "code": "batch.records[batch.n++] = *r;" },
      { "change": "turn", "name": "64-bit time", "at": "picoA.move.move_imu",
        "what": "the first record's time into µs since power-up (never wraps); the others by the period",
        "path": "picoA/app/move.c", "code": "batch.t_us = clock_since_start_of(batch.records[0].t_us);" },
      { "change": "turn", "name": "encode", "at": "picoA.wire.wire_encode_imu_batch",
        "what": "into the imu batch message: 15 B header, 12 B a record (the records' own times dropped)",
        "bytes": 135,
        "path": "picoA/app/wire.c", "code": "uint32_t wire_encode_imu_batch(const wire_imu_batch_t *b, uint8_t *out) {" },
      { "at": "picoA.link_pc.link_send_bulk", "path": "picoA/app/move.c", "code": "if (link_send_bulk(msg, n)) cur.imu_sent++;" },
      { "at": "pc.wire.WireReader.push", "path": "pc/robot/src/link.ts", "code": "for (const raw of reader.push(chunk))" },
      { "change": "turn", "name": "decode", "at": "pc.wire.decode",
        "what": "the bytes into records, each with its own time again", "dto": "pc.wire.ImuBatch",
        "path": "pc/robot/src/wire.ts", "code": "case TYPE.IMU_BATCH: {" },
      { "at": "pc.link.RobotLink", "path": "pc/robot/src/link.ts", "code": "case \"imu_batch\": this.emit(\"imu\", withoutType(m)); break;" },
      { "at": "pc.ingest.ingest", "path": "pc/robot/src/ingest.ts", "code": "robot.on(\"imu\", (batch: ImuBatch)" },
      { "change": "turn", "name": "seconds", "at": "pc.boot.Boot.imu",
        "what": "numbered as the boot's next message; times in seconds", "dto": "pc.boot.ImuRow",
        "path": "pc/robot/src/boot.ts", "code": "imu(batch: ImuBatch, atMs = Date.now()): ImuRow {" },
      { "at": "pc.store.Store.imu" }
    ]
  },
  {
    "id": "tof-frame",
    "name": "ToF frame to the PC",
