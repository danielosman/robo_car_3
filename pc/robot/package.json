{
  "name": "robocar-robot-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RoboCar robot server: PicoA connects here over WiFi; the browser and the robot CLI steer it; DuckDB stores what it sends (doc/ARCHITECTURE.md).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "fakerobot": "node src/fakerobot.ts",
    "place-objects": "node src/objects/place_again.ts",
    "typecheck": "tsc -p .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ws": "8.18.2",
    "eslint": "^10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "minimatch": "^11.0.6"
  }
}
