{
  "name": "robocar-robot-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RoboCar PicoA console over WiFi: the robot connects here, the browser shows it (doc/ARCHITECTURE.md).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test src/robot.test.ts src/recording.test.ts src/store.test.ts src/viewer_api.test.ts src/snapshot.test.ts",
    "decode": "node src/decode.ts",
    "import": "node src/import.ts",
    "frames": "node src/frames.ts",
    "snapreplay": "node src/snapreplay.ts",
    "fakerobot": "node src/fakerobot.ts",
    "typecheck": "tsc -p .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
