# Settings for npm start (src/main.ts). Copy to .env and change what you need;
# .env is not in git. The values here are the defaults.

# The vision model for robot detect (src/objects/model.ts). Its name must start
# with gemma or qwen: that picks the system prompt (src/objects/session.ts).
MODEL_API=http://127.0.0.1:8080
MODEL=gemma-4-26b
# The most tokens robot detect lets the model think; then it must answer.
# robot detect --reasoning-budget=N overrides it for one run. -1: no limit.
REASONING_BUDGET=2000

# Ports and where the server announces itself
# PORT=8081
# ROBOT_PORT=4211
# DATA_PORT=4212
# Default: every network's broadcast. 127.0.0.1 for a test server only.
# ANNOUNCE_TO=127.0.0.1
